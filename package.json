{
  "name": "orca-web", "private": true, "version": "0.1.0", "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=22 <23 || >=24 <25" },
  "scripts": {
    "dev": "pnpm --parallel --filter @orca-web/server --filter @orca-web/web dev",
    "build": "pnpm --filter @orca-web/shared build && pnpm --filter @orca-web/server build && pnpm --filter @orca-web/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:integration": "pnpm build && tsx scripts/integration.ts",
    "test:integration:docker": "sh scripts/test-docker-integration.sh",
    "test:browser": "playwright test",
    "start": "node apps/server/dist/index.js"
  },
  "devDependencies": { "@playwright/test": "^1.56.0", "@types/node": "^22.18.0", "tsx": "^4.20.0", "typescript": "^5.9.3", "vitest": "^3.2.4" }
}
